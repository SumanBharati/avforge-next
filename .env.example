# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (AI features)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (embeddings)
VOYAGE_API_KEY=pa-...

# Brevo (email — team invites)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Stripe (AVGenix Pro subscription)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO (all optional)
# Canonical public domain used in metadata, sitemap and structured data (defaults to https://avgenix.com)
NEXT_PUBLIC_SITE_URL=https://avgenix.com
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (nothing loads until this is set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Search-engine ownership verification tokens (Search Console "HTML tag" method / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
